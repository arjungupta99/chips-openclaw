{
  "name": "@chipschat/openclaw",
  "version": "1.0.9",
  "description": "OpenClaw as a Chips harness: one operator connection to the OpenClaw gateway, Chips's public wire on the other side.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arjungupta99/chips-openclaw.git",
    "directory": "bridge"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "chips-openclaw": "dist/main.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "connect": "tsx src/main.ts connect",
    "keep": "tsx src/main.ts --keep",
    "test": "node --import tsx --test test/*.test.ts",
    "e2e": "node --import tsx --test test/e2e/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "release": "npm run build && npm test && npm pack"
  },
  "devDependencies": {
    "@chipschat/conformance": "file:vendor/chipschat-conformance-1.0.0.tgz",
    "@chipschat/harness": "file:vendor/chipschat-harness-1.0.0.tgz",
    "@chipschat/protocol": "file:vendor/chipschat-protocol-1.0.0.tgz",
    "@openclaw/gateway-client": "2026.9.6",
    "@openclaw/gateway-protocol": "2026.9.6",
    "@types/node": "22.19.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.27.7",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "ws": "8.21.3"
  }
}
