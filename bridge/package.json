  },
  "dependencies": {
    "@chips/harness": "file:vendor/chips-harness-0.0.0.tgz",
    "@chips/protocol": "file:vendor/chips-protocol-0.0.0.tgz",
    "@openclaw/gateway-client": "2026.9.6",
    "@openclaw/gateway-protocol": "2026.9.6",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@chips/conformance": "file:vendor/chips-conformance-0.0.0.tgz",
    "@types/node": "22.19.0",
    "@types/ws": "8.18.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
